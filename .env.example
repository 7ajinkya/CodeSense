# CodeSense local AI configuration. Copy to `.env` next to the CodeSense
# extension installation (development: the repository root) and fill in.
# `.env` is git-ignored and never committed — keep real secrets only there.
# Values set directly in the environment always override these.
CODESENSE_AI_API_KEY=
CODESENSE_AI_BASE_URL=https://api.openai.com/v1
CODESENSE_AI_MODEL=gpt-4o-mini
CODESENSE_AI_TIMEOUT_MS=60000
# Optional dogfooding override: idle-trigger threshold in milliseconds.
# Default is 600000 (10 minutes) when absent or invalid. The 45-minute hard
# evaluation boundary is never configurable.
# CODESENSE_IDLE_THRESHOLD_MS=60000
