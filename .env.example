# CodeSense local AI configuration (copy to `.env` and fill in).
# `.env` is git-ignored and never committed — keep real secrets only there.
# Values set directly in the environment always override these.
CODESENSE_AI_API_KEY=
CODESENSE_AI_BASE_URL=https://api.openai.com/v1
CODESENSE_AI_MODEL=gpt-4o-mini
CODESENSE_AI_TIMEOUT_MS=60000
